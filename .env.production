# Used by `next build` / production. Do not put secrets here.
# No trailing slash — trailing slash breaks some API proxies (//api/...).
API_URL=https://bisonstechserpbackend-production.up.railway.app
APP_URL=https://app.bisonstechs.com
NEXT_PUBLIC_APP_URL=https://app.bisonstechs.com
NEXT_PUBLIC_MARKETING_URL=https://bisonstechs.com
# Shared auth cookies across app.bisonstechs.com + {slug}.bisonstechs.com
COOKIE_DOMAIN=.bisonstechs.com
NEXT_PUBLIC_COOKIE_DOMAIN=.bisonstechs.com
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=bisonstechs.com
NEXT_PUBLIC_POS_DESKTOP_VERSION=1.0.4
NEXT_PUBLIC_POS_DESKTOP_GITHUB_REPO=arshad-dev57/accounting-desktop
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://github.com/arshad-dev57/accounting-desktop/releases/download/v1.0.4/Bisonstechs.POS-1.0.4-mac-arm64.dmg
NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC=https://github.com/arshad-dev57/accounting-desktop/releases/download/v1.0.4/Bisonstechs.POS-1.0.4-mac-arm64.dmg
NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC_INTEL=https://github.com/arshad-dev57/accounting-desktop/releases/download/v1.0.4/Bisonstechs.POS-1.0.4-mac-x64.dmg
NEXT_PUBLIC_DESKTOP_DOWNLOAD_WIN=https://github.com/arshad-dev57/accounting-desktop/releases/download/v1.0.4/Bisonstechs.POS-1.0.4-win-x64.exe
