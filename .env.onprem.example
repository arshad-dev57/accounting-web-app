# Bisonstechs — Windows on-premise web app (TEMPLATE)
# Copy to .env.onprem before building. Do NOT commit the real .env.onprem file.
#
# IMPORTANT: API_URL is read at BUILD time (next.config rewrites) AND at runtime
# (Route Handlers). Set it before `build-production.ps1`.

PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# ── Backend (same machine — not exposed to office LAN) ─────────
API_URL=http://127.0.0.1:5000

# ── App URLs (replace with this server's LAN IP — not committed) ─
# Example: http://192.168.1.100:3000
APP_URL=http://192.168.1.100:3000
NEXT_PUBLIC_APP_URL=http://192.168.1.100:3000

# ── Cookies (HTTP LAN — required for login on http://192.168.x.x) ─
COOKIE_SECURE=false
COOKIE_DOMAIN=
NEXT_PUBLIC_COOKIE_DOMAIN=

# ── Marketing / desktop (optional on-prem) ─────────────────────
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC=
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_WIN=
